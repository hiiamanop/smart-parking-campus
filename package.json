{
  "name": "smart-parking-kampus",
  "version": "0.3.0",
  "private": true,
  "description": "Smart Parking Kampus - driver app, admin dashboard, gate kiosk, VLM.",
  "scripts": {
    "build": "npm --prefix app run build && npm --prefix client run build && npm --prefix gate run build",
    "build:admin": "npm --prefix app run build",
    "build:client": "npm --prefix client run build",
    "build:gate": "npm --prefix gate run build",
    "dev:server": "npm --prefix server start",
    "dev:admin": "npm --prefix app run dev",
    "dev:client": "npm --prefix client run dev",
    "dev:gate": "npm --prefix gate run dev",
    "test:server": "npm --prefix server test",
    "deploy": "npm run build && docker compose up -d --build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
