# Smart Parking - Environment Variables
# Salin file ini ke .env lalu isi nilainya.
# JANGAN commit .env (berisi API key).

# OpenRouter (wajib untuk fitur VLM / baca plat nomor)
OPENROUTER_API_KEY=

# Base URL OpenRouter API (default resmi)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model VLM via OpenRouter (hanya dipakai bila VLM_PROVIDER=openrouter)
OPENROUTER_VLM_MODEL=google/gemini-2.5-flash

# Model "thinking" untuk asisten operator (OpenRouter)
OPENROUTER_ASSISTANT_MODEL=deepseek/deepseek-v4-flash

# Voice assistant: STT + TTS via OpenRouter (gpt-audio = audio in/out)
OPENROUTER_STT_MODEL=openai/gpt-audio
OPENROUTER_TTS_MODEL=openai/gpt-audio
OPENROUTER_TTS_VOICE=nova
VOICE_MAX_SECONDS=120

# VLM plat nomor: server lokal OpenAI-compatible (vLLM)
# Jalankan vLLM dengan --served-model-name sesuai VLLM_MODEL, lalu sesuaikan URL.
VLM_PROVIDER=vllm
VLLM_BASE_URL=http://host.docker.internal:8001/v1
VLLM_MODEL=gemma-4-12b
VLLM_API_KEY=
VLM_TIMEOUT_MS=90000

# Opsional: identifikasi app ke OpenRouter
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Smart Parking Kampus

# Server proxy lokal (menjaga API key tetap di server, tidak di browser)
VLM_PROXY_PORT=8788
VLM_PROXY_HOST=127.0.0.1

# URL proxy yang dipakai web app (Vite dev/prod)
VITE_VLM_PROXY_URL=http://127.0.0.1:8788

# Redis untuk state live (opsional bila memakai backend bawaan server/)
REDIS_URL=redis://127.0.0.1:6379

# Token API (opsional). Kosong = pengecekan dimatikan (mode dev).
# Isi untuk mengunci endpoint admin & gate/VLM.
ADMIN_API_TOKEN=
GATE_API_TOKEN=

# Supabase (self-hosted storage) - dipakai di SERVER, tidak dikirim ke browser.
# Salin dari workspace storage: SUPABASE_PUBLISHABLE_KEY (atau ANON_KEY).
# Di Docker Compose, SUPABASE_URL diarahkan ke gateway internal: http://kong:8000
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_KEY=
# Service-role key untuk arsip parking_history (server-side, jangan ke browser).
SUPABASE_SERVICE_ROLE_KEY=

# Arsip JSONL lokal (default: server/../data/history)
HISTORY_DIR=

# Zona waktu untuk interpretasi ETA HH:MM dan analitik per jam.
TZ=Asia/Jakarta
